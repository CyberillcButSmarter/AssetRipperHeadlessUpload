[Unit]
Description=AssetRipper Headless Upload host
After=network-online.target
Wants=network-online.target
# Stop hammering restarts if it can't start (e.g. the port is taken): give up
# after 5 failures in 60s instead of crash-looping forever.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=assetripper
Group=assetripper
# Defaults; override HOST/PORT in /etc/assetripper.env
Environment=HOST=0.0.0.0
Environment=PORT=8087
EnvironmentFile=-/etc/assetripper.env
WorkingDirectory=/opt/assetripper/current
ExecStart=/opt/assetripper/current/AssetRipper.GUI.Free --host ${HOST} --port ${PORT} --headless
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
